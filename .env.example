# Configuration de l'application Fit&Fun
# Copiez ce fichier en .env et remplissez les valeurs

# Base de données
DB_HOST=localhost
DB_NAME=db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Application
APP_ENV=development
APP_DEBUG=true
APP_URL=https://fitandfun.lunyx.xyz

# Configuration Email (SMTP)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=votre_email@example.com
MAIL_PASSWORD=votre_mot_de_passe
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@fitandfun.fr
MAIL_FROM_NAME="Fit&Fun"
